# ─────────────────────────────────────────────
# Fleetr — Environment Variables
# ─────────────────────────────────────────────

# ── Server ──────────────────────────────────
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ── MongoDB ─────────────────────────────────
MONGO_URI=mongodb://localhost:27017/fleetr

# ── Redis ───────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Firebase Admin SDK ──────────────────────
FIREBASE_SERVICE_ACCOUNT_KEY=./firebase-service-account.json

# ── ULIP (Unified Logistics Interface Platform) ──
ULIP_BASE_URL=https://www.ulipstg.dpiit.gov.in
ULIP_CLIENT_ID=
ULIP_CLIENT_SECRET=
ULIP_USERNAME=
ULIP_PASSWORD=

# ── Razorpay ────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── MapmyIndia (Mappls) ────────────────────
MAPMYINDIA_CLIENT_ID=
MAPMYINDIA_CLIENT_SECRET=

# ── Google Gemini AI ────────────────────────
GOOGLE_GEMINI_API_KEY=

# ── SMS Gateway (MSG91 / Kaleyra) ──────────
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=

# ── TRAI DLT Compliance ────────────────────
TRAI_DLT_PRINCIPAL_ENTITY_ID=
TRAI_DLT_DEFAULT_HEADER=FLEETR

# ── WhatsApp (Meta Cloud API) ──────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ── JWT / Session ───────────────────────────
JWT_FALLBACK_SECRET=change-me-in-production
